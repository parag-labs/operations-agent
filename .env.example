# Operations Agent runs on a deterministic mock planner by default, so no API keys are
# needed to develop, test, build, or run the demo.

# Optional Postgres. If unset, the app uses an in-memory store (fine for the demo and CI unit
# tests). CI's integration job sets this to a throwaway Postgres service.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/operations_agent

# Which planner to use: "mock" (default, deterministic) or a real provider you wire in.
OPERATIONS_AGENT_PLANNER=mock

# Only needed if you wire a real provider into src/engine/llm.ts. Never commit a real key.
# OPENAI_API_KEY=sk-...
